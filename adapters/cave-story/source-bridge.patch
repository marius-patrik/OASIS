+//! OASIS source-native headless entrypoint, applied as an exact patch to the
+//! pinned doukutsu-rs implementation. All physics remains in Player::tick.
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::io::Cursor;
+
+use crate::entity::GameEntity;
+use crate::framework::context::Context;
+use crate::framework::error::GameResult;
+use crate::game::filesystem_container::FilesystemContainer;
+use crate::game::map::Map;
+use crate::game::physics::PhysicalEntity;
+use crate::game::stage::{Stage, StageData, Tileset, Background, BackgroundType, NpcType};
+use crate::common::Color;
+use crate::framework::error::GameError;
+use crate::game::npc::list::NPCList;
+use crate::game::player::{Player,TargetPlayer};
+use crate::game::inventory::Inventory;
+use crate::game::weapon::{WeaponType,WeaponLevel};
+use crate::game::weapon::bullet::BulletManager;
+use crate::game::shared_game_state::SharedGameState;
+use crate::input::player_controller::PlayerController;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Buttons {
+    pub left: bool,
+    pub right: bool,
+    pub up: bool,
+    pub down: bool,
+    pub jump: bool,
+    pub shoot: bool,
+}
+#[derive(Clone, Default)]
+struct InputLatch {
+    current: Rc<RefCell<Buttons>>,
+    previous: Rc<RefCell<Buttons>>,
+}
+impl InputLatch {
+    fn held(&self)->Buttons{*self.current.borrow()}
+    fn pressed(&self)->Buttons{
+        let b=*self.current.borrow();
+        let p=*self.previous.borrow();
+        Buttons {
+            left:b.left&&!p.left,right:b.right&&!p.right,
+            up:b.up&&!p.up,down:b.down&&!p.down,
+            jump:b.jump&&!p.jump,shoot:b.shoot&&!p.shoot,
+        }
+    }
+}
+impl PlayerController for InputLatch {
+    fn update(&mut self,_state:&mut SharedGameState,_ctx:&mut Context)->GameResult{Ok(())}
+    fn update_trigger(&mut self){*self.previous.borrow_mut()=*self.current.borrow();}
+    fn move_up(&self)->bool{self.held().up}
+    fn move_left(&self)->bool{self.held().left}
+    fn move_down(&self)->bool{self.held().down}
+    fn move_right(&self)->bool{self.held().right}
+    fn prev_weapon(&self)->bool{false}
+    fn next_weapon(&self)->bool{false}
+    fn map(&self)->bool{false}
+    fn inventory(&self)->bool{false}
+    fn jump(&self)->bool{self.held().jump}
+    fn shoot(&self)->bool{self.held().shoot}
+    fn skip(&self)->bool{false}
+    fn strafe(&self)->bool{false}
+    fn trigger_up(&self)->bool{self.pressed().up}
+    fn trigger_left(&self)->bool{self.pressed().left}
+    fn trigger_down(&self)->bool{self.pressed().down}
+    fn trigger_right(&self)->bool{self.pressed().right}
+    fn trigger_prev_weapon(&self)->bool{false}
+    fn trigger_next_weapon(&self)->bool{false}
+    fn trigger_map(&self)->bool{false}
+    fn trigger_inventory(&self)->bool{false}
+    fn trigger_jump(&self)->bool{self.pressed().jump}
+    fn trigger_shoot(&self)->bool{self.pressed().shoot}
+    fn trigger_skip(&self)->bool{false}
+    fn trigger_strafe(&self)->bool{false}
+    fn trigger_menu_ok(&self)->bool{false}
+    fn trigger_menu_back(&self)->bool{false}
+    fn trigger_menu_pause(&self)->bool{false}
+    fn look_up(&self)->bool{self.held().up}
+    fn look_left(&self)->bool{self.held().left}
+    fn look_down(&self)->bool{self.held().down}
+    fn look_right(&self)->bool{self.held().right}
+    fn move_analog_x(&self)->f64{(self.held().right as i32-self.held().left as i32) as f64}
+    fn move_analog_y(&self)->f64{(self.held().down as i32-self.held().up as i32) as f64}
+    fn set_rumble(&mut self,_low_freq:u16,_hi_freq:u16,_ticks:u32){}
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PlayerFrame {
+    pub x:i32,pub y:i32,pub vel_x:i32,pub vel_y:i32,
+    pub life:u16,pub collision_flags:u32,
+}
+pub struct Simulation {
+    pub player:Player,
+    state:SharedGameState,
+    _context:Context,
+    _filesystem:FilesystemContainer,
+    npc_list:NPCList,
+    stage:Option<Stage>,
+    inventory:Inventory,
+    bullets:BulletManager,
+    second_player:Player,
+    input:InputLatch,
+}
+impl Simulation {
+    pub fn new()->GameResult<Self>{
+        let mut context=Context::new();
+        context.headless=true;
+        let mut filesystem=FilesystemContainer::new();
+        filesystem.mount_fs(&mut context)?;
+        let mut state=SharedGameState::new(&mut context)?;
+        let mut player=Player::new(&mut state,&mut context);
+        player.cond.set_alive(true);
+        state.control_flags.set_control_enabled(true);
+        let input=InputLatch::default();
+        player.controller=Box::new(input.clone());
+        let (npc_list,_token)=NPCList::new();
+        let second_player=Player::new(&mut state,&mut context);
+        Ok(Self{player,state,_context:context,_filesystem:filesystem,
+            npc_list,stage:None,inventory:Inventory::new(),
+            bullets:BulletManager::new(),second_player,input})
+    }
+    pub fn controls(&mut self,buttons:Buttons){*self.input.current.borrow_mut()=buttons;}
+    /// Equip a weapon using the original Cave Story inventory and enum.
+    pub fn equip_weapon(&mut self,wtype:WeaponType,level:WeaponLevel,
+        experience:u16,ammo:u16,max_ammo:u16){
+        self.inventory.add_weapon_data(wtype,ammo,max_ammo,experience,level);
+        self.player.current_weapon=wtype as u8;
+    }
+    pub fn active_bullets(&self)->usize{self.bullets.bullets.len()}
+    pub fn current_weapon_state(&self)->Option<(u8,u8,u16,u16,u16)>{
+        self.inventory.get_current_weapon().map(|w|(
+            w.wtype as u8,w.level as u8,w.experience,w.ammo,w.max_ammo,
+        ))
+    }
+    pub fn frame(&self)->PlayerFrame {
+        PlayerFrame {
+            x:self.player.x,y:self.player.y,
+            vel_x:self.player.vel_x,vel_y:self.player.vel_y,
+            life:self.player.life,collision_flags:self.player.flags.0,
+        }
+    }
+    /// Load an original Cave Story PXM tilemap and source-native attribute
+    /// table. The upstream map reader and collision solver stay authoritative.
+    pub fn load_stage(&mut self,pxm:&[u8],attributes:&[u8])->GameResult<()>{
+        if pxm.len()<8 || &pxm[0..3]!=b"PXM" || pxm[3]!=0x10
+            || attributes.len()!=256 {
+            return Err(GameError::ResourceLoadError("invalid original PXM map".into()));
+        }
+        let width=usize::from(u16::from_le_bytes([pxm[4],pxm[5]]));
+        let height=usize::from(u16::from_le_bytes([pxm[6],pxm[7]]));
+        let count=width.checked_mul(height).ok_or_else(||
+            GameError::ResourceLoadError("map dimensions overflow".into()))?;
+        if width==0 || height==0 || count>usize::from(u16::MAX)
+            || pxm.len()!=count+8 {
+            return Err(GameError::ResourceLoadError("invalid original map size".into()));
+        }
+        let map=Map::load_pxm(Cursor::new(pxm),Cursor::new(attributes))?;
+        self.state.tile_size=map.tile_size;
+        let data=StageData {
+            name:String::new(),name_jp:String::new(),map:String::new(),
+            boss_no:0,tileset:Tileset::new("0"),pxpack_data:None,
+            background:Background::new("bk0"),background_type:BackgroundType::Black,
+            background_color:Color::from_rgb(0,0,0),
+            npc1:NpcType::new("0"),npc2:NpcType::new("0"),
+        };
+        self.stage=Some(Stage{map,data});
+        Ok(())
+    }
+    /// Apply the source-owned movement state supplied by the native adapter
+    /// to the original Player object, not a parallel platform physics model.
+    /// This currently preserves movement fields only, not all scene internals.
+    pub fn restore_frame(&mut self,frame:PlayerFrame){
+        self.player.x=frame.x;
+        self.player.y=frame.y;
+        self.player.vel_x=frame.vel_x;
+        self.player.vel_y=frame.vel_y;
+        self.player.prev_x=frame.x;
+        self.player.prev_y=frame.y;
+        self.player.life=frame.life;
+        self.player.flags.0=frame.collision_flags;
+    }
+    pub fn tick(&mut self)->GameResult<PlayerFrame>{
+        // Match the original GameScene::tick_world order: movement first,
+        // source-native tile physics next, never a platform-side solver.
+        self.player.tick(&mut self.state,&self.npc_list)?;
+        if let Some(stage)=self.stage.as_mut(){
+            self.player.tick_map_collisions(&mut self.state,&self.npc_list,stage);
+        }
+        // Continue the original GameScene::tick_world weapon/bullet order.
+        // Original gameplay code determines ammo, refire timing, projectile
+        // spawning, native projectile movement and map collision.
+        self.inventory.tick_weapons(&mut self.state,&mut self.player,
+            TargetPlayer::Player1,&mut self.bullets);
+        self.bullets.tick_bullets(&mut self.state,
+            [&self.player,&self.second_player],&self.npc_list);
+        if let Some(stage)=self.stage.as_mut(){
+            self.bullets.tick_map_collisions(&mut self.state,&self.npc_list,stage);
+        }
+        self.state.tick_carets();
+        self.player.controller.update_trigger();
+        Ok(self.frame())
+    }
+}
